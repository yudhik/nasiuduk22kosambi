# Stage 1: Build React + Vite frontend
FROM docker.io/library/node:22-alpine AS frontend-builder
WORKDIR /app/frontend

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

# Stage 2: Build 100% static x86_64-unknown-linux-musl Rust binary
FROM docker.io/library/rust:1-bookworm AS backend-builder
WORKDIR /app/backend

ARG CARGO_BUILD_JOBS=2
ENV CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS} \
    CC_x86_64_unknown_linux_musl=musl-gcc

RUN apt-get update \
    && apt-get install -y --no-install-recommends musl-tools file \
    && rm -rf /var/lib/apt/lists/* \
    && rustup target add x86_64-unknown-linux-musl

# Pre-build dependencies for layer caching
COPY backend/Cargo.toml backend/Cargo.lock ./
RUN mkdir -p src migrations \
    && echo "fn main() {}" > src/main.rs \
    && echo "" > src/lib.rs \
    && cargo build --release --locked --target x86_64-unknown-linux-musl \
    && rm -rf src

# Build actual application (including embedded SQLite migrations)
COPY backend/src ./src
COPY backend/migrations ./migrations
RUN touch src/main.rs src/lib.rs \
    && cargo build --release --locked --target x86_64-unknown-linux-musl \
    && strip target/x86_64-unknown-linux-musl/release/nota-digital-backend \
    && file target/x86_64-unknown-linux-musl/release/nota-digital-backend

# Stage 3: Minimal artifact bundle (extractable without Docker on target server)
FROM scratch AS bundle
COPY --from=backend-builder /app/backend/target/x86_64-unknown-linux-musl/release/nota-digital-backend /nota-digital-backend
COPY --from=frontend-builder /app/frontend/dist /static
COPY deploy/nota-digital.service /nota-digital.service
